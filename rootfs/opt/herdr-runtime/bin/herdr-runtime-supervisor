#!/usr/bin/python3
"""Process supervisor for the herdr runtime container (runs as tini's child).

Start order: prepare $HOME (the PVC) -> `herdr --session assistant server` (wait for `api snapshot`) -> task bridge
-> sshd (non-root, :2222, public key only) -> skills.

Skills (k8s#75): the single source is the public repository mouse9527/skills. The `skills` child runs its projector
(bin/skills-project, vendored): every 5 min `main` -> full commit SHA -> immutable release of $SKILLS_GROUPS under
~/.local/share/agent-skills (current switched atomically; a failed fetch keeps the current one), and leaf links
~/.agents/skills/<id> (Codex, Pi) and ~/.claude/skills/<id> (Claude Code) -> current. It only ever touches links it
created; a user's own entry with the same name is left alone (and logged). Links to the skills that used to be baked
into this image (/opt/herdr-runtime/skills/…) are removed at start. A child that exits is restarted with backoff; if herdr exits, the bridge
is stopped and started again after herdr is back (its startup recovery reports lost executions as interrupted).
SIGTERM: stop the bridge (no new tasks), `herdr server stop` (lets herdr save its layout), stop sshd, exit.

$HOME is an NFS volume. Unix sockets and lock files must not live there, and herdr always creates its sockets inside
~/.config/herdr/sessions/<session>/. So ~/.config/herdr/sessions is a symlink into $HERDR_RUNTIME_DIR (local emptyDir;
`herdr session list` ignores a symlinked session dir but follows a symlinked parent), and only
herdr's layout state (session.json, session-snapshots/) is kept on the volume: restored before the server starts,
saved every minute and after a clean stop. A hard kill can lose up to a minute of layout changes.

Environment:
  HERDR_SESSION (assistant)  BRIDGE_DISABLED=1  SSH_DISABLED=1  SSH_PORT (2222)
  SKILLS_GROUPS (dev)  SKILLS_REPO (mouse9527/skills)  SKILLS_REF (main, or a full SHA to pin)  SKILLS_DISABLED=1
  SSH_AUTHORIZED_KEYS (/etc/herdr-runtime/ssh/authorized_keys; mount it read-only, the agent must not edit it)
"""
import json, os, shutil, signal, subprocess, sys, time
from pathlib import Path

OPT = Path('/opt/herdr-runtime')
HOME = Path(os.environ.get('HOME') or '/home/agent')
SESSION = os.environ.get('HERDR_SESSION', 'assistant')
RUN = Path(os.environ.get('HERDR_RUNTIME_DIR', '/tmp/herdr-runtime'))
STATE = HOME / '.local/state/herdr-runtime'
WS = Path(os.environ.get('WS_ROOT') or HOME / 'workspaces/assistant')
# Variables an SSH session needs to see the same herdr/CLI setup as the server. Never add secrets here.
SSH_ENV = ('PATH', 'HERDR_CONFIG_PATH', 'HERDR_SESSION', 'WS_ROOT', 'DISABLE_AUTOUPDATER', 'PI_SKIP_VERSION_CHECK',
           'GH_NO_UPDATE_NOTIFIER', 'LANG', 'BRIDGE_INTERNAL_PORT')
HERDR_LOCAL = RUN / 'herdr'                      # sockets, lock, live session dir (local disk)
HERDR_SAVED = STATE / 'herdr-session'           # layout state copy (volume)
SAVE_SECONDS = 60
SKILLS_ROOT = HOME / '.local/share/agent-skills'
SKILL_DIRS = (HOME / '.agents/skills', HOME / '.claude/skills')    # Codex + Pi read the first, Claude Code the second
BAKED_SKILLS = '/opt/herdr-runtime/skills/'                          # before k8s#75
stopping = False


def log(*a):
    print(time.strftime('%Y-%m-%dT%H:%M:%S'), 'supervisor:', *a, flush=True)


def link(target, path):
    """Point path at target unless the user put a real file or directory there (never overwrite user content)."""
    path.parent.mkdir(parents=True, exist_ok=True)
    if path.is_symlink():
        if os.readlink(path) == str(target):
            return
        path.unlink()
    elif path.exists():
        log('keeping user file', path)
        return
    path.symlink_to(target)


def copy_missing(src, dst):
    """Copy a template tree without touching anything that already exists."""
    for s in sorted(src.rglob('*')):
        d = dst / s.relative_to(src)
        if s.is_symlink():
            if not d.exists() and not d.is_symlink():
                d.parent.mkdir(parents=True, exist_ok=True)
                d.symlink_to(os.readlink(s))
        elif s.is_dir():
            d.mkdir(parents=True, exist_ok=True)
        elif not d.exists():
            d.parent.mkdir(parents=True, exist_ok=True)
            shutil.copyfile(s, d)


def local_link(path, target):
    """Make path a symlink to a local target. A real file or dir there (older layout) is removed after the caller
    saved what it needs."""
    path.parent.mkdir(parents=True, exist_ok=True)
    if path.is_symlink():
        if os.readlink(path) == str(target):
            return
        path.unlink()
    elif path.is_dir():
        shutil.rmtree(path)
    elif path.exists():
        path.unlink()
    path.symlink_to(target)


def save_herdr_state(src):
    """Copy herdr's layout state from src to the volume; skip a session.json that is mid-write (invalid JSON)."""
    HERDR_SAVED.mkdir(parents=True, exist_ok=True)
    sj = src / 'session.json'
    if sj.is_file():
        data = sj.read_bytes()
        try:
            json.loads(data)
        except ValueError:
            log('session.json not valid JSON, not saved this time')
        else:
            tmp = HERDR_SAVED / 'session.json.tmp'
            tmp.write_bytes(data)
            os.replace(tmp, HERDR_SAVED / 'session.json')
    snaps = src / 'session-snapshots'
    if snaps.is_dir():
        new, old = HERDR_SAVED / 'session-snapshots.new', HERDR_SAVED / 'session-snapshots'
        shutil.rmtree(new, ignore_errors=True)
        shutil.copytree(snaps, new)
        shutil.rmtree(old, ignore_errors=True)
        os.replace(new, old)


def prepare_herdr_session():
    local = HERDR_LOCAL / 'sessions' / SESSION
    local.mkdir(parents=True, exist_ok=True)
    link = HOME / '.config/herdr/sessions'
    old = link / SESSION
    if not link.is_symlink() and old.is_dir() and not old.is_symlink():
        save_herdr_state(old)         # state written by an image that kept the session on the volume
    local_link(link, HERDR_LOCAL / 'sessions')
    local_link(HOME / '.config/herdr/.plugins.lock', HERDR_LOCAL / 'plugins.lock')
    for name in ('session.json', 'session-snapshots'):
        src, dst = HERDR_SAVED / name, local / name
        if src.is_dir():
            shutil.rmtree(dst, ignore_errors=True)
            shutil.copytree(src, dst)
        elif src.is_file():
            shutil.copyfile(src, dst)
    return local


def retire_baked_skill_links():
    """Remove the links earlier images made to their baked-in skills (the projector links the repository's now)."""
    for root in ('.claude/skills', '.codex/skills', '.pi/agent/skills'):
        d = HOME / root
        for p in sorted(d.iterdir()) if d.is_dir() else []:
            if p.is_symlink() and os.readlink(p).startswith(BAKED_SKILLS):
                p.unlink()
                log('removed old skill link', p)


def skills_child():
    argv = [sys.executable, str(OPT / 'bin/skills-project'), 'release',
            '--github', os.environ.get('SKILLS_REPO', 'mouse9527/skills'), '--ref', os.environ.get('SKILLS_REF', 'main'),
            '--groups', os.environ.get('SKILLS_GROUPS', 'dev'), '--root', str(SKILLS_ROOT), '--loop', '300']
    for d in SKILL_DIRS:
        argv += ['--link', str(d)]
    return Child('skills', argv)


def prepare_home():
    for d in (STATE / 'ssh', HOME / '.claude', HOME / '.codex', HOME / '.pi/agent', WS / 'repos', WS / 'topics', RUN):
        d.mkdir(parents=True, exist_ok=True)
    os.chmod(STATE / 'ssh', 0o700)
    copy_missing(OPT / 'templates/ws', WS)
    retire_baked_skill_links()
    for d in (SKILLS_ROOT, *SKILL_DIRS):
        d.mkdir(parents=True, exist_ok=True)
    guide = OPT / 'templates/agent-guide.md'
    for path in (HOME / '.claude/CLAUDE.md', HOME / '.codex/AGENTS.md', HOME / '.pi/agent/AGENTS.md'):
        link(guide, path)
    codex_cfg = HOME / '.codex/config.toml'
    if not codex_cfg.exists():
        codex_cfg.write_text('# Written once by herdr-runtime; edit freely.\ncheck_for_update_on_startup = false\n')
    key = STATE / 'ssh/ssh_host_ed25519_key'
    if not key.exists():
        subprocess.run(['ssh-keygen', '-q', '-t', 'ed25519', '-N', '', '-C', 'herdr-runtime-host', '-f', str(key)],
                       check=True)
        log('generated ssh host key', key)
    for kind in ('claude', 'codex', 'pi'):
        r = subprocess.run(['herdr', 'integration', 'install', kind], capture_output=True, text=True)
        log('herdr integration install', kind, 'rc=%d' % r.returncode, (r.stdout + r.stderr).strip()[:200])


def sshd_config():
    keys = os.environ.get('SSH_AUTHORIZED_KEYS', '/etc/herdr-runtime/ssh/authorized_keys')
    env = ' '.join('%s="%s"' % (k, os.environ[k]) for k in SSH_ENV if os.environ.get(k))
    text = (OPT / 'etc/sshd_config.in').read_text()
    for k, v in {'PORT': os.environ.get('SSH_PORT', '2222'), 'HOST_KEY': str(STATE / 'ssh/ssh_host_ed25519_key'),
                 'RUN': str(RUN), 'AUTHORIZED_KEYS': keys, 'USER': os.environ.get('USER', 'agent'),
                 'ENV': env}.items():
        text = text.replace('{{' + k + '}}', v)
    path = RUN / 'sshd_config'
    path.write_text(text)
    return path


def herdr_ready(timeout):
    deadline = time.time() + timeout
    while time.time() < deadline and not stopping:
        r = subprocess.run(['herdr', '--session', SESSION, 'api', 'snapshot'], capture_output=True, text=True)
        if r.returncode == 0 and '"session_snapshot"' in r.stdout:
            return True
        time.sleep(0.5)
    return False


class Child:
    def __init__(self, name, argv, ready=None, new_session=False):
        self.name, self.argv, self.ready, self.new_session = name, argv, ready, new_session
        self.proc, self.failures, self.next_start, self.started = None, 0, 0.0, 0.0

    def alive(self):
        return self.proc is not None and self.proc.poll() is None

    def start(self):
        log('start', self.name)
        self.started = time.time()
        self.proc = subprocess.Popen(self.argv, stdin=subprocess.DEVNULL, start_new_session=self.new_session)
        if self.ready and not self.ready(30):
            log(self.name, 'not ready within 30s')
            self.stop()
            return False
        return True

    def stop(self, timeout=10):
        if self.alive():
            self.proc.terminate()
            try:
                self.proc.wait(timeout)
            except subprocess.TimeoutExpired:
                self.proc.kill()
                self.proc.wait()

    def exited(self):
        """Record an exit and schedule the restart: 1, 2, 4 … 30 s; reset after a minute of healthy running."""
        self.failures = 0 if time.time() - self.started > 60 else self.failures + 1
        delay = min(30, 2 ** self.failures)
        log(self.name, 'exited rc=%s, restart in %ds' % (self.proc.returncode if self.proc else '-', delay))
        self.proc, self.next_start = None, time.time() + delay


def main():
    global stopping
    prepare_home()
    session_dir = prepare_herdr_session()
    last_save = time.time()
    # herdr only reports the detached_server_daemon capability (required by `herdr machine add`) when the server is
    # a session leader (getsid(0) == getpid()), as when it daemonizes itself with setsid(). It is still our child:
    # we watch it, signal it by pid and stop it with `herdr server stop`; tini only signals us, not this session.
    herdr = Child('herdr', ['herdr', '--session', SESSION, 'server'], ready=herdr_ready, new_session=True)
    others = []
    if os.environ.get('BRIDGE_DISABLED') != '1':
        others.append(Child('bridge', [sys.executable, str(OPT / 'bridge/herdr_bridge.py')]))
    if os.environ.get('SSH_DISABLED') != '1':
        others.append(Child('sshd', ['/usr/sbin/sshd', '-D', '-e', '-f', str(sshd_config())]))
    if os.environ.get('SKILLS_DISABLED') != '1':
        others.append(skills_child())

    def on_signal(signum, _):
        global stopping
        stopping = True
        log('signal', signum)
    signal.signal(signal.SIGTERM, on_signal)
    signal.signal(signal.SIGINT, on_signal)

    while not stopping:
        if not herdr.alive():
            if herdr.proc is not None:
                herdr.exited()
                for c in others:
                    if c.name == 'bridge' and c.alive():
                        c.stop()
            if time.time() >= herdr.next_start and not herdr.start():
                herdr.exited()
            time.sleep(0.5)
            continue
        for c in others:
            if c.alive():
                continue
            if c.proc is not None:
                c.exited()
            elif time.time() >= c.next_start:
                c.start()
        if time.time() - last_save >= SAVE_SECONDS:
            try:
                save_herdr_state(session_dir)
            except OSError as e:
                log('saving herdr state failed:', e)
            last_save = time.time()
        time.sleep(1)

    # Fits a 30 s stop budget (docker default; the Pod gets 60 s): bridge ≤5 s, herdr ≤15 s, then the state save,
    # which must happen even when herdr is slow to stop.
    t0 = time.time()
    for c in others:
        if c.name == 'bridge':
            c.stop(5)
    try:
        if herdr.alive():
            r = subprocess.run(['herdr', '--session', SESSION, 'server', 'stop'], capture_output=True, text=True,
                               timeout=10)
            log('herdr server stop rc=%d after %.1fs' % (r.returncode, time.time() - t0))
            herdr.proc.wait(5)
    except subprocess.TimeoutExpired:
        log('herdr did not stop in time after %.1fs; terminating it' % (time.time() - t0))
    finally:
        herdr.stop(3)
        try:
            save_herdr_state(session_dir)
            log('saved herdr state after %.1fs' % (time.time() - t0))
        except OSError as e:
            log('saving herdr state failed:', e)
    for c in others:
        c.stop(3)
    log('stopped after %.1fs' % (time.time() - t0))


if __name__ == '__main__':
    main()
